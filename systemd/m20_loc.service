# ============================================================================
# m20_loc.service —— 开机自启 M20 定位链路(驱动直出三话题)
#                    boot-start the M20 localization chain (driver-native)
# ----------------------------------------------------------------------------
# 假设仓库克隆在 /home/user/fslam;克隆在别处则改 ExecStart 路径。
# Assumes the repo is cloned at /home/user/fslam — adjust ExecStart otherwise.
#
# 与 rtk_loc.service 二选一,别同时 enable —— 两套都发 /ODOM。
# Mutually exclusive with rtk_loc.service; never enable both, they both
# publish /ODOM.
#
# 安装 | install:
#   sudo systemctl disable --now rtk_loc     # 先停 Python 版 | stop the Python one
#   sudo cp systemd/m20_loc.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now m20_loc
# ============================================================================
[Unit]
Description=M20 Localization Service (fslam, driver-native)
Wants=network-online.target docker.service
After=network-online.target docker.service
# 同时跑会有两个 /ODOM 发布者 | two /ODOM publishers otherwise
Conflicts=rtk_loc.service fslam_loc.service

[Service]
# 启动脚本把容器(--restart unless-stopped)拉起后即退出 → oneshot +
# RemainAfterExit,状态语义才正确(active=已部署)。这里没有宿主机节点,
# 驱动进程自己处理开机 DDS 装聋(m20.boot_reinit_*)。
# The launcher exits once the container is up (kept alive by the docker restart
# policy) → oneshot + RemainAfterExit gives honest status semantics. There are
# no host-side nodes here; the driver handles startup DDS deafness itself via
# m20.boot_reinit_*.
Type=oneshot
RemainAfterExit=yes
User=root

# 等物理网卡拿到 IP(FP 设备走 TCP)| wait for a physical NIC to get an IP
ExecStartPre=/bin/bash -c "echo '[INFO] waiting for physical network IP...'; while ! ip -4 addr show | grep -E '^[0-9]+: (eth|en)' -A 2 | grep -q 'inet '; do sleep 1; done; echo '[INFO] IP found'"
# DDS 组播路由钉到通信网卡(按实际通信网卡改 eth0)| pin the DDS multicast
# route to the comms NIC (change eth0 to match the rig)
ExecStartPre=/sbin/ip route replace 224.0.0.0/4 dev eth0
ExecStartPre=/bin/sleep 2

ExecStart=/bin/bash /home/user/fslam/run_m20_prod.sh
ExecStop=/bin/bash -c "docker stop m20-runtime; docker rm m20-runtime; exit 0"
TimeoutStartSec=180

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
