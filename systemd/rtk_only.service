# ============================================================================
# rtk_only.service —— 开机自启 M20 定位链路(Foxy 原生,无容器)
#                         boot-start the M20 localization chain (native Foxy)
# ----------------------------------------------------------------------------
# 假设仓库克隆在 /home/user/fslam,工作区在 /home/user/m20_ws。
# Assumes the repo at /home/user/fslam and the workspace at /home/user/m20_ws.
#
# 和 m20_loc.service(Humble 容器版)、rtk_loc.service(Python 版)三选一 ——
# 三套都发 /ODOM,同时起等于给导航多个打架的位姿源。
# One of rtk_only / m20_loc / rtk_loc, never more: all three publish /ODOM.
#
# 安装 | install:
#   sudo systemctl disable --now rtk_loc m20_loc
#   sudo cp systemd/rtk_only.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rtk_only
# ============================================================================
[Unit]
Description=M20 Localization Service (fslam, native Foxy)
Wants=network-online.target
After=network-online.target
# 都发 /ODOM | all of these publish /ODOM
Conflicts=fslam.service fslam_native.service rtk_loc.service m20_loc.service m20_loc_foxy.service

[Service]
# 容器版是 oneshot(起完容器就退,靠 docker 的 restart policy 保活);这里驱动是本
# 服务的直接子进程,所以用 simple + Restart,由 systemd 负责拉起。
# The container unit is oneshot (docker's restart policy keeps it alive). Here the
# driver is this unit's own child, so simple + Restart lets systemd supervise it.
Type=simple
Restart=on-failure
RestartSec=5
User=root

# 等物理网卡拿到 IP(FP 设备走 TCP)| wait for a physical NIC to get an IP
ExecStartPre=/bin/bash -c "echo '[INFO] waiting for physical network IP...'; while ! ip -4 addr show | grep -E '^[0-9]+: (eth|en)' -A 2 | grep -q 'inet '; do sleep 1; done; echo '[INFO] IP found'"
# DDS 组播路由钉到通信网卡 | pin the DDS multicast route to the comms NIC
ExecStartPre=/sbin/ip route replace 224.0.0.0/4 dev eth0

# OEM 的雷达驱动在整机上电时可能先于雷达就绪启动,那样它不会创建点云 writer
# (日志照发 send success,但 /LIDAR/POINTS 没有 publisher)。等一会儿再起,
# 让 rsdriver 有机会先把 writer 建出来;真碰上了就 systemctl restart rsdriver。
# The OEM lidar driver can start before the lidars are ready at power-on, in which
# case it never creates its cloud writers (it still logs "send success", but
# /LIDAR/POINTS has no publisher). Give it time; if it still happens, the fix is
# systemctl restart rsdriver. See MEMORY: m20-lidar-points-publisher-failure.
ExecStartPre=/bin/sleep 10

# 开机就绪门:等时钟阶跃过去 + OEM DDS 节点群起完(根因与实测见脚本头注)。
# 在"定"了的系统上创建 participant,配对实测 100% 可靠 —— 一次起对,无需事后重启。
# Boot readiness gate: wait out the clock step and the OEM DDS crowd (root
# cause + measurements in the script header). Participants created on a
# settled system pair 100% reliably — start correctly once, no healing needed.
ExecStartPre=/home/user/fslam/tools/wait_boot_settled.sh 240

# 等 VRTK2 的 TCP 口可达再起驱动(上限 120s,超时告警但放行)。开机时传感网交换机
# 比本机慢:驱动会先建好 DDS participant 再连 TCP,连不上就退出 → systemd 拉起 →
# 开机风暴里多一具 DDS 尸体。尸体会毒化 Fast DDS 共享内存端口,曾把别的
# writer/reader 配对楔死(2026-08-12 排查:/GRID_MAP latch 楔死 1.5h)。
# 先探到端口再起,进程就不会在开机窗口死亡。
# Gate the driver start on the VRTK2 TCP port (cap 120 s, then warn and proceed).
# At power-on the sensor-net switch lags this host; the driver creates its DDS
# participant BEFORE the TCP connect, so a failed connect exits the process ->
# systemd restarts it -> one more abrupt DDS death in the boot storm. Corpses
# poison Fast DDS SHM ports and have wedged unrelated writer/reader pairings
# (2026-08-12: the /GRID_MAP latch wedged for 1.5 h). Probing first means the
# process never dies in the boot window.
ExecStartPre=/bin/bash -c "timeout 120 bash -c 'until echo > /dev/tcp/10.21.31.66/21000; do sleep 2; done' 2>/dev/null && echo '[INFO] VRTK reachable' || echo '[WARN] VRTK not reachable after 120s — starting anyway'"

ExecStart=/bin/bash /home/user/fslam/run_rtk_only_native.sh
# 预链最坏情形:就绪门 240s + VRTK 门 120s + 杂项 —— 默认 90s 会把门阶段杀掉重试
# (2026-08-12 实测 map-server 因此 NRestarts=2,无害但脏)。
# Worst-case pre-chain: 240 s gate + 120 s VRTK gate + slack — the 90 s default
# kills the gate phase and retries (measured: map-server NRestarts=2; harmless
# but untidy).
TimeoutStartSec=420

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
