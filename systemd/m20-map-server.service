# ============================================================================
# m20-map-server.service —— OEM 占据栅格地图发布(支持服务,与定位模式无关)
#                           OEM occupancy-grid map publisher (support service,
#                           independent of the localization mode)
# ============================================================================
# 跑的是 OEM 的原生 DrDDS 程序(Fast DDS 2.14),把 active 地图 latched 发布到
# `/GRID_MAP`(nav_msgs/OccupancyGrid,reliable + transient-local;`occ_grid`
# 是地图名不是话题名;ROS graph 里 passable_area 发的 /grid_map 是另一回事)。
# 消费者是 OEM 导航栈的 transient-local 读者;原生 writer 在 Foxy graph 里
# 时隐时现,以订阅收到为准。
#
# Runs the OEM's native DrDDS binary (Fast DDS 2.14): LATCHES the active map on
# `/GRID_MAP` (nav_msgs/OccupancyGrid, reliable + transient-local; `occ_grid`
# is the map NAME, not the topic — and the ROS-graph /grid_map from
# passable_area is unrelated). Consumers are the OEM nav stack's
# transient-local readers; the native writer's graph visibility is flaky, so
# judge by reception, not `ros2 topic info`.
#
# 为什么归 fslam 管:OEM 的 localization.service(会起完整原厂定位,与我们的
# /ODOM 冲突)被禁用后,地图发布这一块随之丢失 —— 单拆出来独立跑。
# Why fslam owns this: disabling the OEM localization.service (it would start
# the full OEM localization -> duplicate /ODOM source) also lost its map
# publishing; this unit carves that single piece out to run standalone.
#
# 安装 | install:
#   cp systemd/m20-map-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now m20-map-server
# ============================================================================
[Unit]
Description=M20 Occupancy Grid Publisher (OEM map_server, fslam-managed)
# time-sync.target = chrony-wait 托管(见 rtk_only.service 同款注释/DEPLOYMENT §3.6)
# time-sync.target is chrony-wait-backed (same rationale as rtk_only.service)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=root

# 等 eth0 拿到 IP;再留 10s 规避 PTP 时间跳变与底层网络抖动(与 m20_loc_foxy 同款)。
# Wait for eth0's IP, then 10 s for PTP step / link settling (same as m20_loc_foxy).
ExecStartPre=/bin/sh -c "while ! ip -4 addr show eth0 | grep -q inet; do sleep 1; done"
# 组播路由钉在 eth0(OEM DDS 网段)。 Pin the DDS multicast route to eth0.
ExecStartPre=+/sbin/ip route replace 224.0.0.0/4 dev eth0

# 默认传输(SHM+UDP)。曾试过 UDP-only 防 SHM 端口毒化,但 2026-08-12 的重启验证
# 表明:astar 对 boot 首发 latch 的接收失败与传输无关(UDP 下同样失败,疑似 OEM
# 内部 LoadMap 启动竞态)—— kick timer 才是对这对配对起效的修复,UDP 无收益,
# 按用户要求回到 SHM。
# Default transports (SHM+UDP). A UDP-only trial against SHM port poisoning was
# reverted: the 2026-08-12 reboot validation showed astar misses the boot-time
# latch REGARDLESS of transport (fails over UDP too — likely an OEM-internal
# LoadMap startup race), so the kick timer is the operative fix for this pair
# and UDP bought nothing. Back to SHM per user preference.
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/aarch64-linux-gnu:/opt/robot/share/localization/lib

# 就绪门最长 240s,默认 TimeoutStartSec=90 会把门阶段杀掉重试(实测 NRestarts=2)。
# The gate can run 240 s; the 90 s TimeoutStartSec default kills and retries it.
TimeoutStartSec=420
ExecStart=/opt/robot/share/localization/bin/map_server /var/opt/robot/data/maps/active/occ_grid.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
