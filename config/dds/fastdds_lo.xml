<?xml version="1.0" encoding="UTF-8"?>
<!-- ========================================================================
  fastdds_lo.xml : 纯环回 participant,仅供 cloud_relay_in.py 使用。
  OEM 雷达驱动的点云 writer 只绑 127.0.0.1(whitelist 仅环回,发不了真实网卡);
  FastDDS 2.6 的 participant 一旦带真实网卡就不通告环回 locator,对端便永远无法
  应答 —— 所以订阅这个 writer 的 participant 必须"只有环回"。实测(2026-08-06,
  ChongQing_106):本 profile 收 /LIDAR/POINTS 稳定 10 Hz,多网卡 profile 0 发现。

  Loopback-only participant, used exclusively by cloud_relay_in.py.
  The OEM lidar driver's cloud writer is bound to 127.0.0.1 only; FastDDS 2.6
  stops announcing a loopback locator once real interfaces are present, so the
  OEM side can never answer such a participant. The subscriber therefore must
  be loopback-only. Measured 2026-08-06 on ChongQing_106: this profile receives
  /LIDAR/POINTS at a stable 10 Hz where every multi-interface variant sees 0
  publishers. Do NOT add real interfaces here.
========================================================================= -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_lo</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>127.0.0.1</address>
            </interfaceWhiteList>
            <sendBufferSize>8388608</sendBufferSize>
            <receiveBufferSize>8388608</receiveBufferSize>
            <maxMessageSize>65500</maxMessageSize>
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="m20_lo_only" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_lo</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
