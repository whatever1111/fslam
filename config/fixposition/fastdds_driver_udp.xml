<?xml version="1.0" encoding="UTF-8"?>
<!--
  UDP-only Fast DDS profile for the M20 driver process.

  Why this exists: the OEM navigation stack mixes Fast DDS generations on one
  host (the ROS 2 Foxy graph runs 2.1.x; the native DrDDS consumers such as
  handler run 2.14). Cross-version shared-memory delivery silently drops LARGE
  samples (the ~0.85 MB /cloud_nav and ~1.2 MB /LIDAR/POINTS class; small
  samples like /ODOM are unaffected), which starves the handler safety gate and
  ends in 0x312. Verified in the 2026-08-10/11 field investigation: the same
  cloud that never arrives over cross-version SHM is received continuously over
  UDP loopback.

  Disabling SHM on OUR participant forces every match with this process onto
  UDP, on both the publish side (handler, planner, basic_server) and the
  subscribe side (the rsdriver lidar writer announces loopback UDP locators -
  that is exactly why the driver must run on Foxy's Fast DDS 2.x line at all).
  Nothing in the OEM's own configuration is touched.

  Activate per deployment by pointing FASTRTPS_DEFAULT_PROFILES_FILE at this
  file for the driver process only (see the fslam launchers). Buffer sizes are
  sized for 10 Hz x ~1.2 MB point clouds.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_only</transport_id>
            <type>UDPv4</type>
            <maxMessageSize>65500</maxMessageSize>
            <sendBufferSize>4194304</sendBufferSize>
            <receiveBufferSize>4194304</receiveBufferSize>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="m20_driver_udp_only" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_only</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
