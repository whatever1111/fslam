# ============================================================================
# Dockerfile.m20 —— M20 定位驱动镜像(在 fslam 基础镜像上叠加)
#                   M20 localization driver image, layered on the base image
# ============================================================================
# 只加 M20 专属的东西:LIO-SLAM 仓库是多产品共用的,不能为 M20 改动它。
# M20-specific only: the LIO-SLAM repository is shared across products and must
# not be modified for this one, so the M20 driver is layered on top of its
# published image instead.
#
# 基础镜像已带 ROS Humble + fixposition-sdk(/usr/local)+ 编译工具链;
# runtime stage 剥掉了 install/ 里的头文件,所以这里从源码重建整套 driver 包。
# The base image carries ROS Humble, the Fixposition SDK under /usr/local and
# the toolchain. Its runtime stage strips headers from install/, so the whole
# driver stack is rebuilt here from source rather than linked against it.
#
# 构建 | build:  tools/build_m20_image.sh   (见该脚本的用法说明)
# ============================================================================
ARG BASE_IMAGE=wanderer123/fslam-humble:arm64
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

# 先清掉基础镜像里可能残留的 driver 源码 —— 不同基础镜像放法不一样(有的是
# src/fixposition_driver 一整棵,有的是拆开的 src/fixposition_driver_*),
# 留着会让 colcon 报 "Duplicate package names not supported"。
# Clear whatever driver sources the base image may carry first: some keep the
# whole tree at src/fixposition_driver, others split it into src/fixposition_*.
# Leaving them in makes colcon fail with "Duplicate package names not supported".
RUN rm -rf /root/ros2_ws/src/fixposition_driver \
           /root/ros2_ws/src/fixposition_driver_lib \
           /root/ros2_ws/src/fixposition_driver_msgs \
           /root/ros2_ws/src/fixposition_driver_ros2 \
           /root/ros2_ws/src/fixposition_driver_m20 \
           /root/ros2_ws/src/rtcm_msgs \
           /root/ros2_ws/src/drdds

# whatever1111/fixposition_driver 分支 m20 的工作副本 | working copy of branch m20
COPY fixposition_driver /root/ros2_ws/src/fixposition_driver

# fixposition_driver_lib 是 cmake-only 包,导出的是裸库名,下游链接需要
# LIBRARY_PATH —— 因此先单独构建它再构建其余(与 LIO-SLAM 基础镜像同样的处理)。
# fixposition_driver_lib is a cmake-only package exporting a bare library name,
# so downstream linking needs LIBRARY_PATH: build it first, then the rest.
RUN source /opt/ros/humble/setup.bash \
    && cd /root/ros2_ws \
    && rm -rf src/fixposition_driver/fixposition-sdk src/fixposition_driver/fixposition_driver_ros1 \
    && colcon build \
       --packages-select fixposition_driver_lib \
       --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && source install/setup.bash \
    && export LIBRARY_PATH=/root/ros2_ws/install/fixposition_driver_lib/lib:${LIBRARY_PATH:-} \
    && colcon build \
       --packages-select rtcm_msgs fixposition_driver_msgs drdds fixposition_driver_m20 fixposition_driver_ros2 \
       --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf build log src/fixposition_driver

# 冒烟检查:可执行文件必须真的链上了 M20 模块,drdds 类型也得能查到 ——
# 否则就是叠到了没打过补丁的 driver 上,现场才发现就晚了。
# Smoke check: the executable must actually link the M20 module and the drdds
# types must resolve. Otherwise this layered onto an unpatched driver, which is
# not something to discover in the field.
RUN source /opt/ros/humble/setup.bash \
    && source /root/ros2_ws/install/setup.bash \
    && ldd "$(ros2 pkg prefix fixposition_driver_ros2)/lib/fixposition_driver_ros2/fixposition_driver_ros2_exec" \
       | grep -q "libfixposition_driver_m20.so" \
    && ros2 interface show drdds/msg/LocationStatus > /dev/null \
    && ros2 interface show drdds/msg/MotionInfo > /dev/null \
    && echo "[OK] M20 driver linked, drdds types resolve"

WORKDIR /root/ros2_ws
